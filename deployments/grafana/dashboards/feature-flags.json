{
  "title": "Feature Flag Engine — Real-Time Data Plane & SDK Observability",
  "uid": "feature-flag-engine-v1",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "SDK Flag Evaluations per Second (by Flag & Outcome)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (flag_key, enabled, reason) (rate(ff_featureflag_sdk_evaluations_total[1m]))",
          "legendFormat": "{{flag_key}} | enabled={{enabled}} ({{reason}})"
        }
      ]
    },
    {
      "id": 2,
      "title": "End-to-End Cache Invalidation Latency (Avg / P50 / P95 / P99 ms)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "targets": [
        {
          "expr": "sum by (flag_key) (ff_featureflag_sdk_propagation_duration_ms_milliseconds_sum) / sum by (flag_key) (ff_featureflag_sdk_propagation_duration_ms_milliseconds_count)",
          "legendFormat": "Avg Latency ({{flag_key}})"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, flag_key) (ff_featureflag_sdk_propagation_duration_ms_milliseconds_bucket))",
          "legendFormat": "P50 ({{flag_key}})"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, flag_key) (ff_featureflag_sdk_propagation_duration_ms_milliseconds_bucket))",
          "legendFormat": "P95 ({{flag_key}})"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, flag_key) (ff_featureflag_sdk_propagation_duration_ms_milliseconds_bucket))",
          "legendFormat": "P99 ({{flag_key}})"
        }
      ]
    },
    {
      "id": 3,
      "title": "Total Evaluations by Reason",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 9 },
      "targets": [
        {
          "expr": "sum by (reason) (ff_featureflag_sdk_evaluations_total)",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Real-Time gRPC Updates Delivered & Stream Reconnects",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 9 },
      "targets": [
        {
          "expr": "sum(ff_featureflag_sdk_propagation_duration_ms_milliseconds_count) or vector(0)",
          "legendFormat": "Real-Time Push Updates"
        },
        {
          "expr": "sum(ff_featureflag_sdk_stream_reconnects_total) or vector(0)",
          "legendFormat": "Stream Reconnects"
        }
      ]
    },
    {
      "id": 5,
      "title": "Mean End-to-End Propagation Latency",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2
        }
      },
      "targets": [
        {
          "expr": "sum(ff_featureflag_sdk_propagation_duration_ms_milliseconds_sum) / sum(ff_featureflag_sdk_propagation_duration_ms_milliseconds_count)",
          "legendFormat": "Avg Propagation (ms)"
        }
      ]
    }
  ]
}
